{
  "name": "glowafrique-storefront",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"api/**/*.js\" \"api-handlers/**/*.js\" \"lib/**/*.js\" \"scripts/**/*.{js,cjs,mjs}\" \"tests/**/*.js\" \".github/workflows/*.yml\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"api/**/*.js\" \"api-handlers/**/*.js\" \"lib/**/*.js\" \"scripts/**/*.{js,cjs,mjs}\" \"tests/**/*.js\" \".github/workflows/*.yml\" \"*.{js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "preview": "vite preview --host 0.0.0.0",
    "build-products": "node scripts/build-products.cjs",
    "admin:promote": "node scripts/promote-admin.mjs",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "optimize-products": "python3 scripts/optimize-product-images.py"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "bcryptjs": "3.0.3",
    "mongodb": "7.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.10.0",
    "eslint": "10.0.0",
    "globals": "17.0.0",
    "prettier": "3.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.0"
  }
}
