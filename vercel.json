{
  "rewrites": [
    { "source": "/kackenlacken", "destination": "/api/router?route=admin/emergency" },
    { "source": "/en/kackenlacken", "destination": "/api/router?route=admin/emergency" },
    { "source": "/api/orders", "destination": "/api/router?route=orders" },
    { "source": "/api/order-quote", "destination": "/api/router?route=order-quote" },
    { "source": "/api/locations", "destination": "/api/router?route=locations" },
    { "source": "/api/payment-proof", "destination": "/api/router?route=payment-proof" },
    { "source": "/api/reviews", "destination": "/api/router?route=reviews" },
    { "source": "/api/admin/orders", "destination": "/api/router?route=admin/orders" },
    { "source": "/api/admin/inventory", "destination": "/api/router?route=admin/inventory" },
    { "source": "/api/admin/emergency", "destination": "/api/router?route=admin/emergency" },
    { "source": "/api/maintenance", "destination": "/api/router?route=maintenance" },
    { "source": "/api/contact", "destination": "/api/router?route=contact" },
    { "source": "/api/newsletter", "destination": "/api/router?route=newsletter" },
    { "source": "/api/auth/register", "destination": "/api/router?route=auth/register" },
    { "source": "/api/auth/login", "destination": "/api/router?route=auth/login" },
    { "source": "/api/auth/logout", "destination": "/api/router?route=auth/logout" },
    { "source": "/api/auth/me", "destination": "/api/router?route=auth/me" },
    { "source": "/api/auth/profile", "destination": "/api/router?route=auth/profile" },
    {
      "source": "/api/auth/password-reset",
      "destination": "/api/router?route=auth/password-reset"
    },
    {
      "source": "/api/payments/paystack/callback",
      "destination": "/api/router?route=payments/paystack/callback"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self'; upgrade-insecure-requests"
        },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
