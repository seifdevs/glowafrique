# Server-only MongoDB configuration. Never expose these values in frontend code.
MONGODB_URI=
MONGODB_DB=glowafrique

# Required to accept orders below the 45,000 XOF free-delivery threshold.
# Set this to GlowAfrique's actual delivery fee in XOF before enabling those orders.
SHIPPING_FEE_XOF=


# Optional one-time administrator bootstrap credentials (server only).
# Set unique real values before running npm run admin:bootstrap.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Optional transactional email and contact-form notifications (server only).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_EMAIL=
PUBLIC_SITE_URL=

# Optional hosted card and mobile-money payments (server only).
# Enable the storefront option only after a live Paystack account has been verified.
PAYSTACK_SECRET_KEY=
VITE_PAYSTACK_ENABLED=false
